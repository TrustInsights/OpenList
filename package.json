{
  "name": "openlist",
  "version": "1.2.0",
  "private": true,
  "description": "Manage and open lists of URLs in new tabs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check src tests *.config.ts",
    "lint:fix": "biome check --write src tests *.config.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip --production && knip",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm run audit && pnpm size",
    "audit": "pnpm audit --audit-level=high",
    "size": "pnpm build && size-limit",
    "index:qmd": "sh src/tools/qmd-index.sh",
    "package": "pnpm build && sh src/tools/package-release.sh",
    "store-images": "pnpm build && playwright test tests/e2e/store-images.spec.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^1.9.0",
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.291",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "size-limit": "^14.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
